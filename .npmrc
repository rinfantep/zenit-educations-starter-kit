cat > .npmrc << 'EOF'
# Registro principal (mirror chino - el más rápido desde Cuba)
registry=https://registry.npmmirror.com

# Reintentos y timeouts EXTREMOS para conexión lenta
fetch-retries=30
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=300000
fetch-timeout=1200000

# Sharp - binarios desde mirror chino
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips

# Configuraciones adicionales para mejorar estabilidad
fetch-retry-factor=5
fetch-retry-multiplier=2
network-concurrency=2
max-connections=5
EOF
#pnpm install --fetch-timeout=1200000 --fetch-retries=30 --fetch-retry-mintimeout=60000 --fetch-retry-maxtimeout=300000